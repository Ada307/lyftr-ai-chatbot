# RelayChat Environment Configuration Example
# Copy to .env and replace placeholder values with your real credentials.

# Required: Comma-separated LLM API keys (at least 2 required for failover)
LLM_API_KEYS=your_first_gemini_key,your_second_gemini_key

# Required: Model identifier supported by LiteLLM (e.g. gemini/gemini-3.5-flash-lite)
LLM_MODEL=gemini/gemini-3.5-flash-lite

# SQLite Database URL (use sqlite:////data/app.db for Docker, sqlite:///./data/app.db for local dev)
DATABASE_URL=sqlite:////data/app.db

# Allowed CORS Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Enable request-scoped failure simulation via X-Simulate-Failure header (true/false)
ENABLE_FAILURE_SIMULATION=true

# Frontend Backend API Base URL (used at build time / local development)
VITE_API_BASE_URL=http://localhost:8000
